# Backend REST API endpoint (Leave empty for localhost:8000 fallback, or set your Render/Railway backend URL)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend WebSocket telemetry stream endpoint
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Map API Key (Not required — free OpenStreetMap / Esri raster tiles are used by default)
# NEXT_PUBLIC_OLA_MAPS_API_KEY=your_ola_maps_api_key_here
# NEXT_PUBLIC_MAP_API_KEY=your_map_api_key_here
