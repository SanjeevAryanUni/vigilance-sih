# PostgreSQL / PostGIS Database Connection URL
# For local development with SQLite fallback, leave unset.
# For production (PostGIS enabled on Render / Supabase / Railway):
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/vigilance_db

# Redis Broker URL for Celery Asynchronous Tasks & WebSockets
# For standalone local execution without Redis, leave unset (falls back to SQLite broker).
REDIS_URL=redis://localhost:6379/0
